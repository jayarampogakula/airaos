# GatiDesk Production Environment Configuration Template
# Copy this file to `.env` in your production directory and fill in your keys.

# 1. System Port & Env
PORT=3001
NODE_ENV=production

# 2. Database & Cache
# If left blank, defaults to using memory-fallback or local server/db.json
DB_PATH=./server/db.json
REDIS_URL=redis://127.0.0.1:6379

# 3. Security Vault Key
# MUST be a 32-character string used to encrypt/decrypt tenant-specific keys in the database.
ENCRYPTION_KEY=gati-os-telephony-encryption-key-32

# 4. Global AI Brain Keys (For Shared Platform Access)
OPENAI_API_KEY=sk-proj-your-openai-key
GEMINI_API_KEY=AIzaSy-your-gemini-key
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 5. Speech-To-Text Key (Crucial for Voice AI Receptionist)
# Get a key from console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-key

# 6. Global Payment Gateway Credentials (PhonePe Integration)
# Configure keys from your PhonePe merchant console
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
